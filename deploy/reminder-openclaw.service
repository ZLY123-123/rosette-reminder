[Unit]
Description=ROSETTE OpenClaw gateway
After=network-online.target reminder.service
Wants=network-online.target

[Service]
Type=simple
User=reminder
Group=reminder
WorkingDirectory=/var/lib/reminder
Environment=HOME=/var/lib/reminder
Environment=OPENCLAW_STATE_DIR=/var/lib/reminder/openclaw
EnvironmentFile=/etc/reminder/openclaw.env
ExecStart=/usr/bin/node /opt/reminder/openclaw/node_modules/openclaw/openclaw.mjs gateway run --bind loopback
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reminder

[Install]
WantedBy=multi-user.target
